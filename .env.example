# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=

# ── Persistence (REQUIRED in production; SQLite is dev/test only) ────────────
# Neon / Vercel Postgres / Supabase / any PostgreSQL-compatible pooler URL.
# Examples: postgres://user:pass@ep-x.pooler.neon.tech/db?sslmode=require
DATABASE_URL=

# Local development override for the SQLite fixture database path (never production).
# DATABASE_PATH=./data/regtech.sqlite

# ── Durable storage for raw official snapshots ───────────────────────────────
# One of: blob (Vercel Blob, preferred) | database (PostgreSQL bytea) | filesystem (dev only)
# Unset => blob when BLOB_READ_WRITE_TOKEN exists; database in production; filesystem in dev.
STORAGE_PROVIDER=
BLOB_READ_WRITE_TOKEN=
# STORAGE_DIR=./storage

# ── Security ─────────────────────────────────────────────────────────────────
# Bearer secret required for ALL mutating API endpoints (POST/PUT/DELETE).
ADMIN_API_KEY=
# Bearer secret accepted by POST/GET /api/jobs/collect (Vercel Cron header).
CRON_SECRET=

# ── Public regulatory alerts ────────────────────────────────────────────────
# Public canonical URL used in confirmation, unsubscribe and change links.
PUBLIC_SITE_URL=https://regtech-umber.vercel.app
# Dedicated HMAC secret for confirmation/unsubscribe links. If unset, CRON_SECRET
# or ADMIN_API_KEY is used as a fallback; a dedicated random value is preferred.
ALERT_TOKEN_SECRET=
# Resend transactional-email API. The sender domain/address must be verified there.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_REPLY_TO=

# ── Optional ─────────────────────────────────────────────────────────────────
# PG_POOL_MAX=3
# Force seeding off even outside production: LCF_ALLOW_SEED=false
